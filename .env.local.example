# ── media-gateway deploy config (deploy.sh) ─────────────────────────────────
# Copy to .env.local and fill in. .env.local is gitignored; this template is
# committed. deploy.sh sources .env.local, builds the binary locally, ships it
# to the server, and restarts the systemd service.

# ── Required ────────────────────────────────────────────────────────────────
# SSH user on the deploy server
SERVER_USER=ubuntu
# Server host / IP
SERVER_HOST=1.2.3.4
# Path to the SSH private key. chmod 600, and point at the actual key file
# (a .pem), not a wrapper script.
SSH_KEY=/path/to/deploy-key.pem
# Git remote the server pulls source from
GIT_REPO=https://github.com/your-org/media-gateway.git

# ── Optional (defaults shown) ───────────────────────────────────────────────
# Install dir on the server
# SERVER_DIR=/opt/rustpbx
# systemd unit restarted after upload
# SERVICE_NAME=rustpbx.service
# Branch the SERVER checks out/pulls. Note: the binary is built from your
# LOCAL checkout, so `git checkout <branch>` locally before deploying too.
# DEPLOY_BRANCH=main

# ── Build env (optional) ─────────────────────────────────────────────────────
# Disable the rustc wrapper if sccache is set in your shell but not installed
# on the build host — otherwise `cargo build` fails with
# "could not execute process sccache". Leave the value empty to disable.
# RUSTC_WRAPPER=

# NOTE: deploy.sh builds with `cargo build --profile deploy`, so run it from a
# Linux x86_64 host matching the server. The script refuses to ship a non-ELF
# (e.g. macOS) binary, and `./deploy.sh rollback` restores the previous one.
